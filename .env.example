# ──────────────────────────────────────────────────────────────
#  HireLens — Environment Variables Template
#  Copy this file to .env and fill in your secrets.
#  NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────

# ─── Backend ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB — use Atlas URI for production, or the local Docker service for dev
# Local Docker:  mongodb://mongodb:27017/interview_db
# Atlas example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/interview_db
DB_URL=mongodb://mongodb:27017/interview_db

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stream (GetStream.io)
STREAM_API_KEY=
STREAM_API_SECRET=

# Frontend URL (used for CORS origin)
CLIENT_URL=http://localhost:3000

# ─── Frontend (Vite build-time vars) ─────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:5000
VITE_STREAM_API_KEY=
